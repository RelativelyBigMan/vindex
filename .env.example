# Copy to .env (never commit .env).
XRPL_NETWORK=testnet          # testnet | devnet
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DEMO_MODE=1                   # 1 = server-held Testnet keys and the persona switcher
DJANGO_HTTPS=0                # 1 only when served over HTTPS (secure cookies, HSTS)
# Sharing the site with other people: use `python scripts/serve.py` (it sets what is needed for that run).
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DJANGO_CSRF_TRUSTED_ORIGINS=
# DJANGO_BEHIND_PROXY=0       # 1 only when every request comes through a tunnel or reverse proxy
